{
  "name": "elisabethkirche-web-player",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "assets": "node scripts/prepare-assets.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "npm run assets && tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test --workers=1"
  },
  "dependencies": {
    "three": "^0.185.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.3.0",
    "@gltf-transform/extensions": "^4.3.0",
    "@gltf-transform/functions": "^4.3.0",
    "@playwright/test": "^1.63.0",
    "@types/three": "^0.183.0",
    "meshoptimizer": "^0.25.0",
    "sharp": "^0.35.5",
    "typescript": "^5.9.0",
    "vite": "^7.3.0"
  }
}
